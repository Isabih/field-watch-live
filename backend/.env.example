# Only the IP normally changes
MQTT_HOST=192.168.1.50
MQTT_PORT=1884
MQTT_USER=myuser
MQTT_PASSWORD=mypass

# Use one long random secret per ESP32. The same value must be in its firmware.
APAFORME_001_SECRET=replace-with-a-long-random-secret
# APAFORME_002_SECRET=replace-with-another-long-random-secret
# APAFORME_003_SECRET=replace-with-another-long-random-secret

# Signed event freshness and replay-protection limits, in seconds/count.
MQTT_MAX_MESSAGE_AGE=30
MQTT_MAX_FUTURE_TIME=10
MQTT_MAX_NONCES=5000
